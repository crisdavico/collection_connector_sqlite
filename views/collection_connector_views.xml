<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_collection_connector_form_sqlite" model="ir.ui.view">
        <field name="name">collection.connector.form.sqlite</field>
        <field name="model">collection.connector</field>
        <field name="inherit_id" ref="collection.view_collection_connector_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
            name="test_connection"
            type="object"
            string="Test Connection"
            class="btn-primary"
            invisible="type != 'sqlite'"
            groups="base.group_system"
          />
                </header>
            </xpath>
            <xpath expr="//field[@name='type']" position="after">
                <field
          name="sqlite_path"
          invisible="type != 'sqlite'"
          required="type == 'sqlite'"
        />
                <field name="sqlite_filename" invisible="1" />
                <field
          name="sqlite_file"
          filename="sqlite_filename"
          readonly="1"
          invisible="type != 'sqlite'"
          groups="base.group_system"
        />
            </xpath>
        </field>
    </record>
</odoo>
